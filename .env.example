WECHAT_COLLECTION_BASE_TOKEN=your_feishu_base_token
WECHAT_COLLECTION_TABLE_ID=your_feishu_table_id

# Optional: override lark-cli location on Windows or custom installs.
# LARK_CLI_BIN=C:\Users\you\AppData\Roaming\npm\lark-cli.cmd

# Optional: Summary Mode extractor path.
# WECHAT_ARTICLE_EXTRACTOR_DIR=C:\path\to\wechat-article-extractor\scripts

# Optional: stats providers.
# WECHAT_STATS_PROVIDER=none
# WECHAT_STATS_FALLBACK_CHAIN=
# WECHAT_OFFICIAL_APPID=
# WECHAT_OFFICIAL_SECRET=
# WECHAT_OFFICIAL_ACCESS_TOKEN=
# WECHAT_OFFICIAL_BEGIN_DATE=
# WECHAT_OFFICIAL_END_DATE=
# WECHAT_OFFICIAL_ARTICLE_TITLE=
# WECHAT_STATS_API_URL=
# WECHAT_STATS_API_KEY=
# WECHAT_SESSION_COOKIE=
# WECHAT_APPMSG_TOKEN=
# WECHAT_PASS_TICKET=
# WECHAT_UIN=
# WECHAT_KEY=
# WECHAT_WXTOKEN=777
